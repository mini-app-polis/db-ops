# db-ops — the names this repo reads. Names only: the values live in Doppler
# (mini-app-polis-ecosystem / dev locally, prd on Railway). Run under
# `doppler run -- …`; do not copy this to .env — nothing reads it.
#
# Uncommented names are required in Doppler's dev config, and
# `uv run check-doppler-keys` checks dev holds every one. Commented names
# are optional: the code has a default. All of these are production-only
# (Doppler prd); development runs skip the backup and need none of them.

# ─────────────────────────────────────────────────────────────────────
# Optional: observability
# ─────────────────────────────────────────────────────────────────────

# Sentry DSN for all three services, told apart by the `service` tag.
# Per-service name rather than the bare fleet name, because Doppler syncs
# one shared config to every Railway service.
# SENTRY_DSN_DB_OPS=

# LOGGING_LEVEL=INFO

# Which environment this process is in. Doppler sets it per config
# (development in dev, production in prd).
# ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────
# db-backup (MINI-63)
# ─────────────────────────────────────────────────────────────────────

# Connection strings as the `backup` role (pg_read_all_data only), over
# Railway private networking: postgresql://backup:<pw>@<host>.railway.internal:5432/railway
DB_BACKUP_DATABASE_URL_KAIANOLEVINE=
DB_BACKUP_DATABASE_URL_DEEJAYTOOLS=

# The off-platform bucket (mini-app-polis/infra database_backups.tf) and the
# write-only key for it. Never the fleet's AWS credentials.
DB_BACKUP_BUCKET=
DB_BACKUP_AWS_ACCESS_KEY_ID=
DB_BACKUP_AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Healthchecks.io check for the nightly run: /start, then success or /fail.
HEALTHCHECKS_URL_DB_BACKUP=

# This repo's own key on api-kaianolevine-com, for run reports (CD-019).
DB_OPS_API_KEY=
# KAIANO_API_BASE_URL=

# Whole-run budget, connection and lock-wait timeouts, and the ping timeout, in
# seconds.
# RUN_TIMEOUT_SECONDS=1800
# DB_CONNECT_TIMEOUT_SECONDS=15
# DB_LOCK_WAIT_TIMEOUT_SECONDS=60
# HEALTHCHECKS_TIMEOUT_SECONDS=5

# Run a real backup outside production, for a deliberate test only.
# DB_BACKUP_ENABLED=
