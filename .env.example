# db-ops — the names this repo reads. Names only: the values live in Doppler
# (mini-app-polis-ecosystem / dev locally, prd on Railway). Run under
# `doppler run -- …`; do not copy this to .env — nothing reads it.
#
# Uncommented names are required in Doppler's dev config, and
# `uv run check-doppler-keys` checks dev holds every one. Commented names
# are optional: the code has a default. All of these are production-only
# (Doppler prd); development runs skip the backup and need none of them.
#
# Production sets none of the budgets, timeouts or _ENABLED switches: each
# runs on its code default, and .railway/railway.ts passes none of them.
# They are for a deliberate local test.

# ─────────────────────────────────────────────────────────────────────
# Optional: observability
# ─────────────────────────────────────────────────────────────────────

# external tooling: read by miniapppolis-common-utils' init_sentry, which
# src/db_ops/_entry.py names it to.
# The shared cogs Sentry project, for all three services, told apart by
# the `service` tag.
# SENTRY_DSN_COGS=

# external tooling: read by miniapppolis-common-utils' logger.
# LOGGING_LEVEL=INFO

# external tooling: read by miniapppolis-common-utils' environment module.
# Which environment this process is in. Doppler sets it per config
# (development in dev, production in prd).
# ENVIRONMENT=development

# Set by Railway on every deploy; the Sentry release. Needed by no local run.
# RAILWAY_GIT_COMMIT_SHA=

# ─────────────────────────────────────────────────────────────────────
# db-backup
# ─────────────────────────────────────────────────────────────────────

# Connection strings as the `backup` role (pg_read_all_data only), over
# Railway private networking: postgresql://backup:<pw>@<host>.railway.internal:5432/railway
DB_BACKUP_DATABASE_URL_KAIANOLEVINE=
DB_BACKUP_DATABASE_URL_DEEJAYTOOLS=

# The off-platform bucket (declared in mini-app-polis/infra) and the
# write-only key for it. Never the fleet's AWS credentials.
DB_BACKUP_BUCKET=
DB_BACKUP_AWS_ACCESS_KEY_ID=
DB_BACKUP_AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Healthchecks.io check for the nightly run: /start, then success or /fail.
HEALTHCHECKS_URL_DB_BACKUP=

# This repo's own key on api-kaianolevine-com, for run reports (CD-019).
DB_OPS_API_KEY=
# external tooling: read by miniapppolis-common-utils when a run report is
# sent: the unsuffixed name in production, the _DEV name everywhere else.
# KAIANO_API_BASE_URL=
# KAIANO_API_BASE_URL_DEV=

# Whole-run budget, connection and lock-wait timeouts, and the ping timeout, in
# seconds.
# DB_BACKUP_RUN_TIMEOUT_SECONDS=1800
# DB_BACKUP_DB_CONNECT_TIMEOUT_SECONDS=15
# DB_LOCK_WAIT_TIMEOUT_SECONDS=60
# HEALTHCHECKS_TIMEOUT_SECONDS=5

# Run a real backup outside production, for a deliberate test only.
# DB_BACKUP_ENABLED=

# ─────────────────────────────────────────────────────────────────────
# db-poller
# ─────────────────────────────────────────────────────────────────────

# Connection strings as the `metrics` role (pg_monitor only), over Railway
# private networking: postgresql://metrics:<pw>@<host>.railway.internal:5432/railway
DB_POLLER_DATABASE_URL_KAIANOLEVINE=
DB_POLLER_DATABASE_URL_DEEJAYTOOLS=

# The db-poller IAM user's key: cloudwatch:PutMetricData on
# MiniAppPolis/Postgres and nothing else (declared in mini-app-polis/infra).
DB_POLLER_AWS_ACCESS_KEY_ID=
DB_POLLER_AWS_SECRET_ACCESS_KEY=

# Run budget, connection timeout and per-statement timeout, and the
# CloudWatch request timeout.
# DB_POLLER_RUN_TIMEOUT_SECONDS=120
# DB_POLLER_DB_CONNECT_TIMEOUT_SECONDS=10
# DB_POLLER_DB_STATEMENT_TIMEOUT_MS=5000
# CLOUDWATCH_TIMEOUT_SECONDS=10

# external tooling: read by miniapppolis-common-utils' effect_enabled.
# Publish outside production, for a deliberate test only.
# CLOUDWATCH_METRICS_ENABLED=

# ─────────────────────────────────────────────────────────────────────
# db-drill
# ─────────────────────────────────────────────────────────────────────

# Connection strings as the `drill` role (pg_read_all_data, owner of the
# `ops` schema), over Railway private networking:
# postgresql://drill:<pw>@<host>.railway.internal:5432/railway
DB_DRILL_DATABASE_URL_KAIANOLEVINE=
DB_DRILL_DATABASE_URL_DEEJAYTOOLS=

# A Railway token that can restore, read and delete services in production.
# Production uses a workspace token (.railway/railway.ts sets
# DB_DRILL_RAILWAY_TOKEN_KIND=workspace): Railway refuses PITR restore with a
# project token. The code's default stays `project`.
DB_DRILL_RAILWAY_TOKEN=
# DB_DRILL_RAILWAY_TOKEN_KIND=project

# Set by Railway on every service; needed only for a local test.
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_ENVIRONMENT_NAME=

# Budgets, in seconds: the whole run (shared by both layers), the wait for
# the fence's WAL to archive, one fork's restore, and the teardown
# confirmation.
# DB_DRILL_RUN_TIMEOUT_SECONDS=5400
# ARCHIVE_WAIT_SECONDS=300
# RESTORE_TIMEOUT_SECONDS=1800
# TEARDOWN_WAIT_SECONDS=300

# The S3 dump drill: the backup bucket (DB_BACKUP_BUCKET, above)
# and the read-only key for it (declared in mini-app-polis/infra).
DB_DRILL_AWS_ACCESS_KEY_ID=
DB_DRILL_AWS_SECRET_ACCESS_KEY=
# Where the image's PostgreSQL 18 server binaries are, one dump's download
# and restore budget together in seconds (capped by what is left of the
# run), and how old the newest dump may be.
# PG_BIN_DIR=/usr/lib/postgresql/18/bin
# DUMP_RESTORE_TIMEOUT_SECONDS=1200
# DUMP_MAX_AGE_HOURS=36

# Connection and per-statement timeouts for the drill's connections.
# DB_DRILL_DB_CONNECT_TIMEOUT_SECONDS=10
# DB_DRILL_DB_STATEMENT_TIMEOUT_MS=60000

# Run a real drill outside production, for a deliberate test only. It still
# refuses any Railway environment but production.
# DB_DRILL_ENABLED=
